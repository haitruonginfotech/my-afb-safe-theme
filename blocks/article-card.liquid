{% stylesheet %}
  .article-card-block {
    min-width: 0;
    max-width: 100%;
    width: var(--article-width, 100%);
    padding-top: var(--article-pad-top, 0);
    padding-bottom: var(--article-pad-bottom, 0);
    padding-left: var(--article-pad-left, 0);
    padding-right: var(--article-pad-right, 0);
  }

  @media screen and (max-width: 749px) {
    .article-card-block {
      width: var(--article-width-mobile, var(--article-width, 100%));
      padding-top: calc(var(--article-pad-top, 0) * var(--article-mobile-scale, 1));
      padding-bottom: calc(var(--article-pad-bottom, 0) * var(--article-mobile-scale, 1));
      padding-left: calc(var(--article-pad-left, 0) * var(--article-mobile-scale, 1));
      padding-right: calc(var(--article-pad-right, 0) * var(--article-mobile-scale, 1));
    }
  }
  .article-card-block .article-card__image.article-card__image--radius {
    border-radius: var(--article-image-radius, 1rem);
  }
{% endstylesheet %}

{%- liquid
  assign s = block.settings

  case s.width
    when 'fill'
      assign width_value = '100%'
    when 'custom'
      assign width_value = s.custom_width | append: '%'
    else
      assign width_value = 'fit-content'
  endcase

  case s.width_mobile
    when 'fill'
      assign width_mobile_value = '100%'
    when 'custom'
      assign width_mobile_value = s.custom_width_mobile | append: '%'
    else
      assign width_mobile_value = 'fit-content'
  endcase

  assign container_width = settings.container_lg_width | default: 1200
  case s.width
    when 'fill'
      assign sizes = '(min-width: ' | append: container_width | append: 'px) ' | append: container_width | append: 'px, 100vw'
    when 'custom'
      assign custom_fraction = s.custom_width | divided_by: 100.0
      assign approx_px = container_width | times: custom_fraction | round
      assign sizes = '(min-width: ' | append: container_width | append: 'px) ' | append: approx_px | append: 'px, ' | append: s.custom_width | append: 'vw'
    else
      assign sizes = '(min-width: ' | append: container_width | append: 'px) calc(' | append: container_width | append: 'px / 2), (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)'
  endcase
-%}

<div
  class="article-card-block"
  style="
    --article-width: {{ width_value }};
    --article-width-mobile: {{ width_mobile_value }};
    --article-pad-top: {{ s.padding_top }}px;
    --article-pad-bottom: {{ s.padding_bottom }}px;
    --article-pad-left: {{ s.padding_left }}px;
    --article-pad-right: {{ s.padding_right }}px;
    --article-mobile-scale: {{ s.mobile_scale | divided_by: 100.0 }};
    --article-image-radius: {{ s.image_corner_radius_value }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if s.article != blank -%}
    {% render 'article-card',
      article: s.article,
      show_image: s.show_image,
      show_date: s.show_date,
      show_author: s.show_author,
      show_comment: s.show_comment,
      show_content: s.show_content,
      button_type: s.read_more_btn_type,
      color_scheme: s.color_scheme,
      corner_radius: s.corner_radius,
      image_ratio: s.image_ratio,
      image_corner_radius: s.image_corner_radius,
      sizes: sizes
    %}
  {%- else -%}
    <article class="blog__items {% if s.corner_radius %}article--card-radius{% endif %}">
      {%- if s.show_image -%}
        <div class="blog__items--thumbnail card--client-height">
          <div class="article-card__image media media--{{ s.image_ratio | default: 'landscape' }}{% if s.image_corner_radius %} article-card__image--radius{% endif %}">
            {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg-new' }}
          </div>
        </div>
      {%- endif -%}
      <div class="blog__items--content color-{{ s.color_scheme }}">
        <h3 class="blog__items--title h4 mb-0">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
        <p class="blog__items--desc">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
      </div>
    </article>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Article card",
  "tag": null,
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "corner_radius",
      "label": "Round corners",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "portrait",  "label": "Portrait (2:3)" },
        { "value": "square",    "label": "Square (1:1)" },
        { "value": "adapt",     "label": "Adapt to image" }
      ],
      "default": "landscape",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "image_corner_radius",
      "label": "Round corners",
      "default": false,
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "range",
      "id": "image_corner_radius_value",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.image_corner_radius and block.settings.show_image }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_comment",
      "label": "Show comment count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show excerpt",
      "default": false
    },
    {
      "type": "header",
      "content": "Read more button"
    },
    {
      "type": "select",
      "id": "read_more_btn_type",
      "label": "Button style",
      "options": [
        { "value": "primary",   "label": "Solid" },
        { "value": "secondary", "label": "Outline" },
        { "value": "link",      "label": "Link" },
        { "value": "none",      "label": "None" }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width (desktop)",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "fill",        "label": "Fill" },
        { "value": "custom",      "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 0, "max": 100, "step": 1, "unit": "%", "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width (mobile)",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "fill",        "label": "Fill" },
        { "value": "custom",      "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "min": 0, "max": 100, "step": 1, "unit": "%", "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "mobile_scale",
      "label": "Mobile scale",
      "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100
    }
  ],
  "presets": [
    {
      "name": "Article card",
      "category": "Blog"
    }
  ]
}
{% endschema %}
