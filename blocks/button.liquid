{% stylesheet %}
  .button-block {
    display: inline-flex;
    width: var(--btn-width, fit-content);
  }
  .button-block .button,
  .button-block .link {
    width: 100%;
  }
  @media screen and (max-width: 749px) {
    .button-block {
      width: var(--btn-width-mobile, var(--btn-width, fit-content));
    }
  }
  .button-block .link.button--with-icon {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .button-block .link.button__underline {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
{% endstylesheet %}

{%- liquid
  assign s = block.settings

  assign btn_classes = s.style_class

  if s.button_icon
    if s.style_class == 'link'
      assign btn_classes = btn_classes | append: ' with--icon'
    endif
    assign btn_classes = btn_classes | append: ' button--with-icon'
  endif

  if s.style_class == 'link'
    if s.underline
      assign btn_classes = btn_classes | append: ' button__underline'
    else
      assign btn_classes = btn_classes | append: ' button--not-underline'
    endif
  endif

  case s.width
    when 'custom'
      assign width_value = s.custom_width | append: '%'
    else
      assign width_value = 'fit-content'
  endcase
  case s.width_mobile
    when 'custom'
      assign width_mobile_value = s.custom_width_mobile | append: '%'
    else
      assign width_mobile_value = 'fit-content'
  endcase
-%}

<div
  class="button-block"
  style="
    --btn-width: {{ width_value }};
    --btn-width-mobile: {{ width_mobile_value }};
  "
  {{ block.shopify_attributes }}
>
  {%- if s.link != blank -%}
    <a
      href="{{ s.link }}"
      class="{{ btn_classes }}"
      {% if s.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    >
      {{- s.label | escape -}}
      {%- if s.button_icon -%}<span class="button--icon button--icon-right">{% render 'icon-chevron-right' %}</span>{%- endif -%}
    </a>
  {%- elsif s.label != blank -%}
    <span class="{{ btn_classes }}">
      {{- s.label | escape -}}
      {%- if s.button_icon -%}<span class="button--icon button--icon-right">{% render 'icon-chevron-right' %}</span>{%- endif -%}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Style",
      "default": "button",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button button--secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "checkbox",
      "id": "button_icon",
      "label": "Use arrow icon",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "underline",
      "label": "Use underline",
      "default": true,
      "visible_if": "{{ block.settings.style_class == 'link' }}"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width (desktop)",
      "default": "fit-content",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width (mobile)",
      "default": "fit-content",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Button",
      "category": "Basic"
    }
  ]
}
{% endschema %}
