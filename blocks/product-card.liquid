{% stylesheet %}
  .product-card-block {
    min-width: 0;
    max-width: 100%;
    width: var(--pc-width, 100%);
    padding-top: var(--pc-pad-top, 0);
    padding-bottom: var(--pc-pad-bottom, 0);
    padding-left: var(--pc-pad-left, 0);
    padding-right: var(--pc-pad-right, 0);
  }

  @media screen and (max-width: 749px) {
    .product-card-block {
      width: var(--pc-width-mobile, var(--pc-width, 100%));
      padding-top: calc(var(--pc-pad-top, 0) * var(--pc-mobile-scale, 1));
      padding-bottom: calc(var(--pc-pad-bottom, 0) * var(--pc-mobile-scale, 1));
      padding-left: calc(var(--pc-pad-left, 0) * var(--pc-mobile-scale, 1));
      padding-right: calc(var(--pc-pad-right, 0) * var(--pc-mobile-scale, 1));
    }
  }
{% endstylesheet %}

{%- liquid
  assign s = block.settings

  case s.width
    when 'fill'
      assign width_value = '100%'
    when 'custom'
      assign width_value = s.custom_width | append: '%'
    else
      assign width_value = 'fit-content'
  endcase

  case s.width_mobile
    when 'fill'
      assign width_mobile_value = '100%'
    when 'custom'
      assign width_mobile_value = s.custom_width_mobile | append: '%'
    else
      assign width_mobile_value = 'fit-content'
  endcase

  assign container_width = settings.container_lg_width | default: 1200
  case s.width
    when 'fill'
      assign sizes = '(min-width: ' | append: container_width | append: 'px) ' | append: container_width | append: 'px, 100vw'
    when 'custom'
      assign custom_fraction = s.custom_width | divided_by: 100.0
      assign approx_px = container_width | times: custom_fraction | round
      assign sizes = '(min-width: ' | append: container_width | append: 'px) ' | append: approx_px | append: 'px, ' | append: s.custom_width | append: 'vw'
    else
      assign sizes = '(min-width: ' | append: container_width | append: 'px) calc(' | append: container_width | append: 'px / 4), (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)'
  endcase
-%}

<div
  class="product-card-block"
  style="
    --pc-width: {{ width_value }};
    --pc-width-mobile: {{ width_mobile_value }};
    --pc-pad-top: {{ s.padding_top }}px;
    --pc-pad-bottom: {{ s.padding_bottom }}px;
    --pc-pad-left: {{ s.padding_left }}px;
    --pc-pad-right: {{ s.padding_right }}px;
    --pc-mobile-scale: {{ s.mobile_scale | divided_by: 100.0 }};
  "
  {{ block.shopify_attributes }}
>
  {%- if s.product != blank -%}
    {% render 'product-card',
      product_card_product: s.product,
      media_size: s.image_ratio,
      show_secondary_image: s.show_secondary_image,
      show_vendor: s.show_vendor,
      show_badge: s.show_badge,
      show_cart_button: s.show_cart_button,
      show_preorder_button: s.show_preorder_button,
      show_quick_view: s.show_quick_view,
      show_quick_compare: s.show_quick_compare,
      show_wishlist: s.show_wishlist,
      show_countdown: s.show_countdown,
      show_title: s.show_title,
      show_price: s.show_price,
      show_rating: s.show_rating,
      card_style: s.card_style,
      color_swatches: s.color_swatches,
      color_scheme: s.color_scheme,
      spacing: s.spacing,
      cart_button_type: s.cart_button_type,
      action_buttons_position: s.action_buttons_position,
      action_buttons_style: s.action_buttons_style,
      show_always: s.show_always,
      low_stock_value: s.low_stock_value,
      minimum_amount_value: s.minimum_amount_value,
      show_inventory_quantity: s.show_inventory_quantity,
      show_inventory_status: s.show_inventory_status,
      in_stock_color: s.in_stock_color,
      out_of_stock_color: s.out_of_stock_color,
      low_stock_color: s.low_stock_color,
      continue_selling_color: s.continue_selling_color,
      corner_radius: s.corner_radius,
      show_border: s.show_border,
      sizes: sizes
    %}
  {%- else -%}
    {%- render 'product-card-placeholder',
      product_item: 'product-apparel-1',
      corner_radius: s.corner_radius,
      image_ratio: s.image_ratio
    -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product card",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Card style"
