{%- liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif

  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  else
    assign container = 'container-fluid px-0'
  endif

  assign video_slide = false
  if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank and section.blocks.first.settings.video != blank
    assign video_slide = true
  endif
-%}

{{ 'slideshow.css' | asset_url | stylesheet_tag }}

{% style %}
      {%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}

        {%- unless section.blocks.first.settings.image2 != blank -%}
        @media screen and (max-width: 767px) {
          {% if video_slide %}
          #slideshow__{{ section.id }} .slideshow__banner--adapt_image.media {
          	height: 39rem;
          }
          {% else %}
          #slideshow__{{ section.id }} .slideshow__banner--adapt_image.media {
          	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          }
          {% endif %}
        }
        {%- endunless -%}

        @media screen and (min-width: 768px) {
          #slideshow__{{ section.id }} .slideshow__banner--adapt_image.media{
          	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          }
        }
        #slideshow__{{ section.id }} .slideshow__banner--adapt_image.placeholder {
        	height: auto;
        }
      {%- endif -%}

      {%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image2 != blank -%}
      @media screen and (max-width: 767px) {
        {% if video_slide %}
        #slideshow__{{ section.id }} .slideshow__banner--adapt_image.media {
        	height: 39rem;
        }
        {% else %}
        #slideshow__{{ section.id }} .slideshow__banner--adapt_image.media {
        	padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image2.aspect_ratio | times: 100 }}%;
        }
        {% endif %}
      }
      {%- endif -%}
      #slideshow__{{ section.id }} .sllideshow__content {
      	background-color: transparent;
      }

      @media only screen and (max-width: 749px) {
        #slideshow__{{ section.id }} .sllideshow__content {
          background-color: var(--slideshow-content-background-color, transparent);
        }
      }

      {%- if section.settings.content_on_container -%}
      @media only screen and (max-width: 767px){
        #slideshow__{{ section.id }} .sllideshow__content {
          position: absolute;
          top: 0;
          width: 100%;
          height: 100%;
          left: 0;
        }
       #slideshow__{{ section.id }} .hero__slider--items__inner {
        	padding: 1.5rem;
        }
      }
      {%- endif -%}

      .placeholder__overlay::before {
          position: absolute;
          content: "";
          width: 100%;
          height: 100%;
          top: 0;
          left: 0;
          background-color: rgba(0,0,0,0.3);
      }

      {%- if section.settings.show_overlay or section.settings.image_overlay_gradient != blank -%}
      .slideshow__media::before {
          position: absolute;
          content: "";
          width: 100%;
          height: 100%;
          top: 0;
          left: 0;
          opacity: {% if section.settings.show_overlay %}{{ section.settings.image_overlay_opacity | divided_by: 100.0 }}{% else %}1{% endif %};
          background: {% if section.settings.image_overlay_gradient != blank %}{{ section.settings.image_overlay_gradient }}{% else %}rgba(0,0,0,1){% endif %};
          z-index: 1;
      }
      {%- endif -%}

      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
          padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
        }

        @media screen and (min-width: 750px) {
          .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
          }
        }
      .slideshow__media > video {
          object-fit: cover;
          object-position: center center;
      }
      @media only screen and (min-width: 750px){
        .hero__slider--section.section-{{ section.id }}-padding{
          --pagnation-color: {{  section.settings.pagination_background.red }}, {{  section.settings.pagination_background.green }}, {{  section.settings.pagination_background.blue }};
          --pagnation-active-color: {{ section.settings.pagination_active_background.red }}, {{ section.settings.pagination_active_background.green }}, {{ section.settings.pagination_active_background.blue }};
        }
      }
      @media only screen and (max-width: 749px){
        .hero__slider--section.section-{{ section.id }}-padding{
          --pagnation-color: {{  section.settings.mobile_pagination_background.red }}, {{  section.settings.mobile_pagination_background.green }}, {{  section.settings.mobile_pagination_background.blue }};
          --pagnation-active-color: {{ section.settings.mobile_pagination_active_background.red }}, {{ section.settings.mobile_pagination_active_background.green }}, {{ section.settings.mobile_pagination_active_background.blue }};
        }
      }
      {% if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image == blank and section.blocks.first.settings.video != blank %}
       @media screen and (max-width: 749px) {
        .slideshow__banner--adapt_image.media {
          height: 39rem;
        }
      }

    @media screen and (min-width: 750px) and (max-width: 991px) {
     .slideshow__banner--adapt_image.media {
          height: 70rem;
        }
    }

    @media screen and (min-width: 992px) {
       .slideshow__banner--adapt_image.media {
          height: 80rem;
        }
    }
      {% endif %}
  @media only screen and (min-width: 750px){
        .hero__slider--inner.swiper.slideshow--centered:not(.swiper-initialized) .swiper-wrapper {
     justify-content: center;
      gap: 2rem;
      flex-wrap: nowrap;
  }

  .hero__slider--inner.swiper.slideshow--centered:not(.swiper-initialized) .swiper-wrapper .swiper-slide {
      width: calc(70% - 2rem);
  }
  }
{% endstyle %}
{% if section.settings.snow_fall %}
  {{ 'snow-fall.css' | asset_url | stylesheet_tag }}
{% endif %}
{%- if theme_rtl -%}
  {{ 'slideshow-rtl.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div
  class="hero__slider--section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-section-type="slideShow"
  id="slideshow__{{ section.id }}"
  data-slide-autoplay="{{ section.settings.auto_rotate }}"
  data-autoplay-duration="{{ section.settings.change_slides_speed }}000"
  data-slide-loop="{{ section.settings.enable_loop }}"
  data-layout="{{ section.settings.layout }}"
>
  <div class="hero__slider--inner hero__slider--activation swiper {% if section.settings.layout == "centered" %}slideshow--centered{% endif %}">
    <div class="hero__slider--wrapper swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            {%- liquid
              assign text_align = ''
              case block.settings.content_alignment
                when 'center'
                  assign text_align = 'text-center'
                when 'start'
                  assign text_align = 'text-left'
                else
                  assign text_align = 'text-right'
              endcase

              assign heading_tag = block.settings.heading_tag | default: 'h2'
              assign subheading_tag = block.settings.subheading_tag | default: 'span'

              assign heading_font_family = 'var(--font-heading-family)'
              assign heading_font_weight = 'var(--font-heading-weight)'
              case block.settings.heading_font_family
                when 'body'
                  assign heading_font_family = 'var(--font-body-family)'
                  assign heading_font_weight = 'var(--font-body-weight)'
                when 'accent'
                  assign heading_font_family = 'var(--font-accent-family)'
                  assign heading_font_weight = 'var(--font-accent-weight)'
                when 'display'
                  assign heading_font_family = 'var(--font-display-family)'
                  assign heading_font_weight = 'var(--font-display-weight)'
              endcase

              assign subheading_font_family = 'var(--font-heading-family)'
              assign subheading_font_weight = 'var(--font-heading-weight)'
              case block.settings.subheading_font_family
                when 'body'
                  assign subheading_font_family = 'var(--font-body-family)'
                  assign subheading_font_weight = 'var(--font-body-weight)'
                when 'accent'
                  assign subheading_font_family = 'var(--font-accent-family)'
                  assign subheading_font_weight = 'var(--font-accent-weight)'
                when 'display'
                  assign subheading_font_family = 'var(--font-display-family)'
                  assign subheading_font_weight = 'var(--font-display-weight)'
              endcase

              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            -%}

            <div
              class="swiper-slide"
              {% if block.settings.content_background_color != blank %}
                style="--slideshow-content-background-color: {{ block.settings.content_background_color }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.enble_entire_link and block.settings.button_link %}
                <a
                  {% if block.settings.button_link %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link"
                  {% endif %}
                  class="d-block"
                >
              {%- endif %}
              <div class="slideshow__media {% if section.settings.snow_fall %}snow--fall{% endif %} slideshow__banner--{{ section.settings.slide_height }} {% if video_slide %} video__slider--height{% endif %} media {% if block.settings.image == blank and block.settings.video == blank %} placeholder  {% if block.settings.image == blank  and block.settings.video == blank %} placeholder__overlay{% endif %}{% endif %} {% if block.settings.image2 != blank %} d-sm-none {% endif %} {% if section.settings.round_corner %}slider--media-corner-radius{% endif %}">
                {% liquid
                  assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
                %}
                {%- if block.settings.video -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, controls: false, muted: true }}
                {%- elsif block.settings.image -%}
                  {%- if forloop.first %}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                    }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              {%- if block.settings.image2 != blank -%}
                <div class="slideshow__media {% if section.settings.snow_fall %}snow--fall{% endif %} slideshow__banner--{{ section.settings.slide_height }} media d-sm-only-visible">
                  <img
                    srcset="
                      {%- if block.settings.image2.width >= 375 -%}{{ block.settings.image2 | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if block.settings.image2.width >= 550 -%}{{ block.settings.image2 | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if block.settings.image2.width >= 750 -%}{{ block.settings.image2 | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if block.settings.image2.width >= 1100 -%}{{ block.settings.image2 | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if block.settings.image2.width >= 1500 -%}{{ block.settings.image2 | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {{ block.settings.image2 | image_url }} {{ block.settings.image2.width }}w
                    "
                    sizes="100vw"
                    src="{{ block.settings.image2 | image_url: width: 1500 }}"
                    loading="lazy"
                    alt="{{ block.settings.image2.alt | escape }}"
                    width="{{ block.settings.image2.width }}"
                    height="{{ block.settings.image2.width | divided_by: block.settings.image2.aspect_ratio | round }}"
                  >
                </div>
              {%- endif -%}

              <div
                class="sllideshow__content color-{{ block.settings.color_scheme }} {% if block.settings.color_scheme_enable %} d-sm-none {% endif %}"
              >
                <div class="{{ container }} h-100">
                  <div class="hero__slider--items__inner h-100">
                    <div class="d-flex align-items-center h-100 justify-content-{{ block.settings.content_alignment }} {{ text_align }}">
                      <div class="col-md-7">
                        <div
                          class="slider__content slider__content--padding__left"
                          style="--slideshow-heading-font-family: {{ heading_font_family }}; --slideshow-heading-font-weight: {{ heading_font_weight }}; --slideshow-heading-size-desktop: {{ block.settings.heading_font_size_desktop | default: 64 }}px; --slideshow-heading-size-tablet: {{ block.settings.heading_font_size_tablet | default: 48 }}px; --slideshow-heading-size-mobile: {{ block.settings.heading_font_size_mobile | default: 36 }}px; {% if block.settings.heading_color != blank and block.settings.heading_color.alpha > 0 %}--slideshow-heading-color: {{ block.settings.heading_color }};{% endif %} {% if block.settings.heading_prefix_color != blank and block.settings.heading_prefix_color.alpha > 0 %}--slideshow-heading-prefix-color: {{ block.settings.heading_prefix_color }};{% endif %} {% if block.settings.heading_suffix_color != blank and block.settings.heading_suffix_color.alpha > 0 %}--slideshow-heading-suffix-color: {{ block.settings.heading_suffix_color }};{% endif %} --slideshow-subheading-font-family: {{ subheading_font_family }}; --slideshow-subheading-font-weight: {{ subheading_font_weight }}; --slideshow-subheading-size-desktop: {{ block.settings.subheading_font_size_desktop | default: 22 }}px; --slideshow-subheading-size-tablet: {{ block.settings.subheading_font_size_tablet | default: 20 }}px; --slideshow-subheading-size-mobile: {{ block.settings.subheading_font_size_mobile | default: 18 }}px; --slideshow-subheading-text-transform: {{ block.settings.subheading_text_transform | default: 'inherit' }}; {% if block.settings.subheading_color_picker != blank and block.settings.subheading_color_picker.alpha > 0 %}--slideshow-subheading-color: {{ block.settings.subheading_color_picker }};{% endif %} --slideshow-text-size-desktop: {{ block.settings.text_font_size_desktop | default: 18 }}px; --slideshow-text-size-tablet: {{ block.settings.text_font_size_tablet | default: 17 }}px; --slideshow-text-size-mobile: {{ block.settings.text_font_size_mobile | default: 16 }}px; {% if block.settings.text_color != blank and block.settings.text_color.alpha > 0 %}--slideshow-text-color: rgba({{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }}, {{ block.settings.text_color_alpha | default: 100 | divided_by: 100.0 }});{% endif %}"
                        >
                          {%- if block.settings.subheading != blank -%}
                            <{{ subheading_tag }} class="slider__content--subtitle {{ block.settings.subheading_color }}">
                              {{- block.settings.subheading -}}
                            </{{ subheading_tag }}>
                          {%- endif -%}

                          {%- if block.settings.heading_prefix_text != blank or block.settings.heading != blank or block.settings.heading_suffix_text != blank -%}
                            <{{ heading_tag }} class="slider__content--maintitle mb-0 gradient--text">
                              {%- if block.settings.heading_prefix_text != blank -%}
                                <span class="slider__content--maintitle-prefix">
                                  {{-
                                    block.settings.heading_prefix_text
                                    | replace: 'p>', 'span>'
                                    | replace: 'h1>', 'span>'
                                    | replace: 'h2>', 'span>'
                                    | replace: 'h3>', 'span>'
                                    | replace: 'h4>', 'span>'
                                    | replace: 'h5>', 'span>'
                                    | replace: 'h6>', 'span>'
                                  -}}
                                </span>
                              {%- endif -%}
                              {{-
                                block.settings.heading
                                | replace: 'p>', 'span>'
                                | replace: 'h1>', 'span>'
                                | replace: 'h2>', 'span>'
                                | replace: 'h3>', 'span>'
                                | replace: 'h4>', 'span>'
                                | replace: 'h5>', 'span>'
                                | replace: 'h6>', 'span>'
                              -}}
                              {%- if block.settings.heading_suffix_text != blank -%}
                                <span class="slider__content--maintitle-suffix">
                                  {{-
                                    block.settings.heading_suffix_text
                                    | replace: 'p>', 'span>'
                                    | replace: 'h1>', 'span>'
                                    | replace: 'h2>', 'span>'
                                    | replace: 'h3>', 'span>'
                                    | replace: 'h4>', 'span>'
                                    | replace: 'h5>', 'span>'
                                    | replace: 'h6>', 'span>'
                                  -}}
                                </span>
                              {%- endif -%}
                            </{{ heading_tag }}>
                          {%- endif -%}

                          {%- if block.settings.text != blank -%}
                            <p class="slider__content--desc">{{ block.settings.text | replace: 'p>', 'span>' }}</p>
                          {%- endif -%}

                          {%- if block.settings.button_label != blank and block.settings.button_2_label != blank -%}
                            <div class="double--buttons-wrapper justify-content-{{ block.settings.content_alignment }}">
                          {% endif %}

                          {% comment %} Buton 1 {% endcomment %}
                          {% liquid
                            if block.settings.button_type == 'primary'
                              assign button_class = 'button--primary'
                            else
                              assign button_class = 'button--secondary'
                            endif
                          %}

                          {%- if block.settings.button_label != blank -%}
                            {% unless block.settings.enble_entire_link %}
                              <a
                                {% if block.settings.button_link %}
                                  href="{{ block.settings.button_link }}"
                                {% else %}
                                  role="link" aria-disabled="true"
                                {% endif %}
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                              >
                            {% endunless %}
                            {% if block.settings.enble_entire_link %}
                              <button
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                              >
                            {%- endif %}
                            {{- block.settings.button_label | escape -}}
                            {% if block.settings.button_icon %}
                              <span class="button--icon button--icon-right"> {% render 'icon-chevron-right' %} </span>
                            {% endif %}
                            {% if block.settings.enble_entire_link %} </button> {% endif %}
                            {% unless block.settings.enble_entire_link %}
                              </a>
                            {% endunless %}
                          {%- endif -%}
                          {% comment %} Buton 1 end {% endcomment %}

                          {% comment %} Buton 2 {% endcomment %}

                          {% liquid
                            if block.settings.button_2_type == 'primary'
                              assign button_class = 'button--primary'
                            else
                              assign button_class = 'button--secondary'
                            endif
                          %}
                          {%- if block.settings.button_2_label != blank -%}
                            {% unless block.settings.enble_entire_link %}
                              <a
                                {% if block.settings.button_2_link %}
                                  href="{{ block.settings.button_2_link }}"
                                {% else %}
                                  role="link" aria-disabled="true"
                                {% endif %}
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                              >
                            {% endunless %}
                            {% if block.settings.enble_entire_link %}
                              <button
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                              >
                            {%- endif %}
                            {{- block.settings.button_2_label | escape -}}
                            {% if block.settings.button_2_icon %}
                              <span class="button--icon button--icon-right"> {% render 'icon-chevron-right' %} </span>
                            {% endif %}
                            {% if block.settings.enble_entire_link %} </button> {% endif %}
                            {% unless block.settings.enble_entire_link %}
                              </a>
                            {% endunless %}
                          {%- endif -%}
                          {% comment %} Buton 2 end {% endcomment %}
                          {%- if block.settings.button_label != blank and block.settings.button_2_label != blank -%}
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {% if block.settings.color_scheme_enable %}
                <div
                  class="sllideshow__content color-{{ block.settings.color_scheme_2 }} d-sm-only-visible"
                >
                  <div class="{{ container }} slide__content_width h-100">
                    <div class="hero__slider--items__inner h-100">
                      <div class="d-flex align-items-center h-100 justify-content-{{ block.settings.content_alignment }} {{ text_align }} ">
                        <div class="col-md-7">
                          <div
                            class="slider__content slider__content--padding__left"
                            style="--slideshow-heading-font-family: {{ heading_font_family }}; --slideshow-heading-font-weight: {{ heading_font_weight }}; --slideshow-heading-size-desktop: {{ block.settings.heading_font_size_desktop | default: 64 }}px; --slideshow-heading-size-tablet: {{ block.settings.heading_font_size_tablet | default: 48 }}px; --slideshow-heading-size-mobile: {{ block.settings.heading_font_size_mobile | default: 36 }}px; {% if block.settings.heading_color != blank and block.settings.heading_color.alpha > 0 %}--slideshow-heading-color: {{ block.settings.heading_color }};{% endif %} {% if block.settings.heading_prefix_color != blank and block.settings.heading_prefix_color.alpha > 0 %}--slideshow-heading-prefix-color: {{ block.settings.heading_prefix_color }};{% endif %} {% if block.settings.heading_suffix_color != blank and block.settings.heading_suffix_color.alpha > 0 %}--slideshow-heading-suffix-color: {{ block.settings.heading_suffix_color }};{% endif %} --slideshow-subheading-font-family: {{ subheading_font_family }}; --slideshow-subheading-font-weight: {{ subheading_font_weight }}; --slideshow-subheading-size-desktop: {{ block.settings.subheading_font_size_desktop | default: 22 }}px; --slideshow-subheading-size-tablet: {{ block.settings.subheading_font_size_tablet | default: 20 }}px; --slideshow-subheading-size-mobile: {{ block.settings.subheading_font_size_mobile | default: 18 }}px; --slideshow-subheading-text-transform: {{ block.settings.subheading_text_transform | default: 'inherit' }}; {% if block.settings.subheading_color_picker != blank and block.settings.subheading_color_picker.alpha > 0 %}--slideshow-subheading-color: {{ block.settings.subheading_color_picker }};{% endif %} --slideshow-text-size-desktop: {{ block.settings.text_font_size_desktop | default: 18 }}px; --slideshow-text-size-tablet: {{ block.settings.text_font_size_tablet | default: 17 }}px; --slideshow-text-size-mobile: {{ block.settings.text_font_size_mobile | default: 16 }}px; {% if block.settings.text_color != blank and block.settings.text_color.alpha > 0 %}--slideshow-text-color: rgba({{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }}, {{ block.settings.text_color_alpha | default: 100 | divided_by: 100.0 }});{% endif %}"
                          >
                            {%- if block.settings.subheading != blank -%}
                              <{{ subheading_tag }} class="slider__content--subtitle {{ block.settings.subheading_color }}">
                                {{- block.settings.subheading -}}
                              </{{ subheading_tag }}>
                            {%- endif -%}

                            {%- if block.settings.heading_prefix_text != blank or block.settings.heading != blank or block.settings.heading_suffix_text != blank -%}
                              <{{ heading_tag }} class="slider__content--maintitle mb-0">
                                {%- if block.settings.heading_prefix_text != blank -%}
                                  <span class="slider__content--maintitle-prefix">
                                    {{-
                                      block.settings.heading_prefix_text
                                      | replace: 'p>', 'span>'
                                      | replace: 'h1>', 'span>'
                                      | replace: 'h2>', 'span>'
                                      | replace: 'h3>', 'span>'
                                      | replace: 'h4>', 'span>'
                                      | replace: 'h5>', 'span>'
                                      | replace: 'h6>', 'span>'
                                    -}}
                                  </span>
                                {%- endif -%}
                                {{-
                                  block.settings.heading
                                  | replace: 'p>', 'span>'
                                  | replace: 'h1>', 'span>'
                                  | replace: 'h2>', 'span>'
                                  | replace: 'h3>', 'span>'
                                  | replace: 'h4>', 'span>'
                                  | replace: 'h5>', 'span>'
                                  | replace: 'h6>', 'span>'
                                -}}
                                {%- if block.settings.heading_suffix_text != blank -%}
                                  <span class="slider__content--maintitle-suffix">
                                    {{-
                                      block.settings.heading_suffix_text
                                      | replace: 'p>', 'span>'
                                      | replace: 'h1>', 'span>'
                                      | replace: 'h2>', 'span>'
                                      | replace: 'h3>', 'span>'
                                      | replace: 'h4>', 'span>'
                                      | replace: 'h5>', 'span>'
                                      | replace: 'h6>', 'span>'
                                    -}}
                                  </span>
                                {%- endif -%}
                              </{{ heading_tag }}>
                            {%- endif -%}

                            {%- if block.settings.text != blank -%}
                              <p class="slider__content--desc">
                                {{- block.settings.text | replace: 'p>', 'span>' -}}
                              </p>
                            {%- endif -%}

                            {% liquid
                              if block.settings.button_type == 'primary'
                                assign button_class = ''
                              else
                                assign button_class = 'button--secondary'
                              endif
                            %}
                            {%- if block.settings.button_label != blank and block.settings.button_2_label != blank -%}
                              <div
                                class="double--buttons-wrapper justify-content-{{ block.settings.content_alignment }}"
                              >
                            {% endif %}

                            {%- if block.settings.button_label != blank -%}
                              <a
                                {% if block.settings.button_link != blank %}
                                  href="{{ block.settings.button_link }}"
                                {% endif %}
                                class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                                {% if block.settings.button_link == blank %}
                                  aria-disabled="true"
                                {% endif %}
                              >
                                {{ block.settings.button_label | escape }}
                                {% if block.settings.button_icon %}
                                  <span class="button--icon button--icon-right">
                                    {% render 'icon-chevron-right' %}
                                  </span>
                                {% endif %}
                              </a>

                              {% comment %} Buton 2 {% endcomment %}

                              {% liquid
                                if block.settings.button_2_type == 'primary'
                                  assign button_class = 'button--primary'
                                else
                                  assign button_class = 'button--secondary'
                                endif
                              %}
                              {%- if block.settings.button_2_label != blank -%}
                                <a
                                  {% if block.settings.button_2_link %}
                                    href="{{ block.settings.button_2_link }}"
                                  {% else %}
                                    role="link" aria-disabled="true"
                                  {% endif %}
                                  class="button button--{{ block.settings.button_size }} {{ button_class }} button--with-icon{% unless block.settings.enable_button_corner %} slideshow__button--no-corner{% endunless %}"
                                >
                                  {{- block.settings.button_2_label | escape -}}
                                  {% if block.settings.button_2_icon %}
                                    <span class="button--icon button--icon-right">
                                      {% render 'icon-chevron-right' %}
                                    </span>
                                  {% endif %}
                                </a>
                              {%- endif -%}
                              {% comment %} Buton 2 end {% endcomment %}
                            {%- endif -%}
                            {%- if block.settings.button_label != blank and block.settings.button_2_label != blank -%}
                              </div>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
              {% if block.settings.enble_entire_link and block.settings.button_link %} </a>{% endif %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_pagination -%}
      <div class="slider__pagination swiper-pagination color-{{ section.settings.color_scheme_pagination }}"></div>
    {%- endif -%}

    {%- if section.settings.show_navigation -%}
      <div class="swiper-button-next slideshow--nav-button color-{{ section.settings.color_scheme_navigation }}">
        {% render 'icon-chevron-right' %}
      </div>
      <div class="swiper-button-prev slideshow--nav-button color-{{ section.settings.color_scheme_navigation }}">
        {% render 'icon-chevron-left' %}
      </div>
    {%- endif -%}
  </div>
</div>

