{{ 'section-title.css' | asset_url | stylesheet_tag }}
{{ 'section-masonry-gallery.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .masonry-gallery-bg-{{ section.id }} {
    {% if section.settings.section_background_color != blank %}
      background-color: {{ section.settings.section_background_color }};
    {% endif %}
    {% if section.settings.section_background_image != blank %}
      background-image: url({{ section.settings.section_background_image | image_url: width: 2400 }});
    {% endif %}
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .masonry-gallery-grid-{{ section.id }} {
    --masonry-columns-desktop: {{ section.settings.columns_desktop }};
    --masonry-columns-tablet: {{ section.settings.columns_tablet }};
    --masonry-columns-mobile: {{ section.settings.columns_mobile }};
    --masonry-gap-desktop: {{ section.settings.gap_desktop }}px;
    --masonry-gap-mobile: {{ section.settings.gap_mobile }}px;
    --masonry-radius: {{ section.settings.image_radius }}px;
    --masonry-mosaic-row-height: {{ section.settings.mosaic_row_height }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign container = 'container'
  if section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  elsif section.settings.container == 'container-full'
    assign container = 'container-fluid px-0'
  endif
-%}

<div class="masonry-gallery masonry-gallery-bg-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="{{ container }}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="masonry-gallery__heading section-heading text-{{ section.settings.heading_alignment }} mb-30">
        {%- if section.settings.subheading_position == 'top' and section.settings.subheading != blank -%}
          <div class="section-heading__sub_title rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading_position == 'bottom' and section.settings.subheading != blank -%}
          <div class="section-heading__sub_title rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="masonry-gallery__grid masonry-gallery__grid--{{ section.settings.layout }} masonry-gallery-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="masonry-gallery__item {% if section.settings.round_corner %}rounded--image{% endif %}" {{ block.shopify_attributes }}>
            {%- if section.settings.enable_popup and block.settings.image != blank -%}
              <a
                class="masonry-gallery__link glightbox masonry-gallery__lightbox-{{ section.id }}"
                href="{{ block.settings.image | image_url: width: 2400 }}"
                data-gallery="masonry-gallery-{{ section.id }}"
                data-title="{{ block.settings.caption | escape }}"
              >
            {%- elsif block.settings.link != blank -%}
              <a class="masonry-gallery__link" href="{{ block.settings.link }}">
            {%- endif -%}
            <div class="masonry-gallery__media">
              {%- if block.settings.image != blank -%}
                {%- capture sizes -%}
                  (min-width: 990px) calc(({{ settings.container_lg_width }}px - {{ section.settings.gap_desktop | times: section.settings.columns_desktop | minus: section.settings.gap_desktop }}px) / {{ section.settings.columns_desktop }}), (min-width: 750px) calc((100vw - 60px) / {{ section.settings.columns_tablet }}), calc((100vw - 30px) / {{ section.settings.columns_mobile }})
                {%- endcapture -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '180, 260, 360, 535, 720, 900, 1100, 1400, 1600'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg-new' }}
              {%- endif -%}
            </div>
            {%- if section.settings.enable_popup and block.settings.image != blank -%}
              </a>
            {%- elsif block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.enable_popup -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function initMasonryGalleryLightbox() {
        if (typeof GLightbox === 'undefined') {
          window.setTimeout(initMasonryGalleryLightbox, 80);
          return;
        }

        GLightbox({
          selector: '.masonry-gallery__lightbox-{{ section.id }}',
          touchNavigation: true,
          loop: true
        });
      }

      initMasonryGalleryLightbox();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Masonry gallery",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Full width"
        },
        {
          "value": "container-full",
          "label": "Full width no padding"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Background color"
    },
    {
      "type": "image_picker",
      "id": "section_background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        },
        {
          "value": "h5",
          "label": "Heading 5"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_position",
      "label": "Subheading position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Gallery layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "masonry",
          "label": "Masonry"
        },
        {
          "value": "mosaic",
          "label": "Featured mosaic"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "mosaic"
    },
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable image popup",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Gap desktop/tablet",
      "default": 8
    },
    {
      "type": "range",
      "id": "mosaic_row_height",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Mosaic / grid row height",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Gap mobile",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "round_corner",
      "label": "Round image corners",
      "default": true
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding top desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding top mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom mobile",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Popup caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masonry gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
