<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign hero_background_gradient = section.settings.section_background_gradient | replace: 'background-image:', '' | replace: 'background:', '' | remove: ';' | strip
-%}

{%- style -%}
  .hero-bg-{{ section.id }} {
    {% if section.settings.section_background_color != blank %}
      background-color: {{ section.settings.section_background_color }};
    {% endif %}
    {% if hero_background_gradient != blank and section.settings.section_background_image != blank %}
      background-image: {{ hero_background_gradient }}, url({{ section.settings.section_background_image | image_url: width: 2400 }});
    {% elsif hero_background_gradient != blank %}
      background-image: {{ hero_background_gradient }};
    {% elsif section.settings.section_background_image != blank %}
      background-image: url({{ section.settings.section_background_image | image_url: width: 2400 }});
    {% endif %}
  }

  {% if section.settings.section_background_image_mobile != blank %}
    @media screen and (max-width: 767px) {
      .hero-bg-{{ section.id }} {
        {% if hero_background_gradient != blank %}
          background-image: {{ hero_background_gradient }}, url({{ section.settings.section_background_image_mobile | image_url: width: 1200 }});
        {% else %}
          background-image: url({{ section.settings.section_background_image_mobile | image_url: width: 1200 }});
        {% endif %}
      }
    }
  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign container = 'container'
  if section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  endif
-%}

<div class="hero-section hero-bg-{{ section.id }} section-{{ section.id }}-padding section--top-space-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="{{ container }}">
    <div class="hero-section__inner">
      <div class="hero-section__content text-{{ section.settings.alignment }} mobile-text-{{ section.settings.mobile_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
              {%- if block.settings.heading != blank -%}
                <{{ heading_tag }}
                  class="hero-section__heading"
                  style="--hero-block-width: {{ block.settings.content_width }}px;{% if block.settings.text_color != blank %} --hero-block-color: {{ block.settings.text_color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading | replace: 'p>', 'span>' }}
                </{{ heading_tag }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div
                  class="hero-section__text rte"
                  style="--hero-block-width: {{ block.settings.content_width }}px;{% if block.settings.text_color != blank %} --hero-block-color: {{ block.settings.text_color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

            {%- when 'image' -%}
              {%- if block.settings.image != blank -%}
                <div
                  class="hero-section__image"
                  style="--hero-image-width: {{ block.settings.image_width }}px;"
                  {{ block.shopify_attributes }}
                >
                  {%- assign image_width_2x = block.settings.image_width | times: 2 -%}
                  {{
                    block.settings.image
                    | image_url: width: image_width_2x
                    | image_tag:
                      loading: 'lazy',
                      widths: '165, 360, 535, 750, 900, 1100, 1400, 1600',
                      sizes: '(min-width: 750px) var(--hero-image-width), 100vw'
                  }}
                </div>
              {%- endif -%}

            {%- when 'icon_text' -%}
              <div
                class="hero-section__icon-list"
                style="
                  --hero-icon-size: {{ block.settings.icon_size }}px;
                  --hero-icon-text-align: {{ block.settings.text_alignment }};
                  {% if block.settings.text_color != blank %}
                    --hero-icon-text-color: {{ block.settings.text_color }};
                  {% endif %}
                  --hero-icon-columns-desktop: {{ block.settings.columns_desktop }};
                  --hero-icon-columns-tablet: {{ block.settings.columns_tablet }};
                  --hero-icon-columns-mobile: {{ block.settings.columns_mobile }};
                "
                {{ block.shopify_attributes }}
              >
                <div class="hero-section__icon-list-inner">
                  {%- for i in (1..6) -%}
                    {%- liquid
                      assign icon_svg_key = 'icon_svg_' | append: i
                      assign icon_image_key = 'icon_image_' | append: i
                      assign text_key = 'text_' | append: i
                      assign icon_svg = block.settings[icon_svg_key]
                      assign icon_image = block.settings[icon_image_key]
                      assign text = block.settings[text_key]
                    -%}
                    {%- if icon_svg != blank or icon_image != blank or text != blank -%}
                      <div class="hero-section__icon-text">
                        {%- if icon_image != blank or icon_svg != blank -%}
                          <span class="hero-section__icon">
                            {%- if icon_image != blank -%}
                              <img
                                src="{{ icon_image | image_url: width: 120 }}"
                                alt="{{ icon_image.alt | escape }}"
                                width="60"
                                height="{{ 60 | divided_by: icon_image.aspect_ratio | ceil }}"
                                loading="lazy"
                              >
                            {%- else -%}
                              {{ icon_svg }}
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                        {%- if text != blank -%}
                          <p class="hero-section__icon-label">{{ text }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                {%- liquid
                  assign button_action = block.settings.button_action | default: 'link'
                  assign button_class = 'button button--primary'
                  if block.settings.button_style == 'secondary'
                    assign button_class = 'button button--secondary'
                  elsif block.settings.button_style == 'link'
                    assign button_class = 'link'
                  endif
                -%}
                <div class="hero-section__buttons" {{ block.shopify_attributes }}>
                  <a
                    {% if button_action == 'scroll_add_to_cart' %}
                      href="#product-form"
                      data-hero-scroll-to-product-form="true"
                    {% elsif block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="{{ button_class }}{% unless block.settings.button_style == 'link' %} button--{{ block.settings.button_size }}{% endunless %}{% if block.settings.button_icon %} button--with-icon{% endif %}"
                  >
                    {{ block.settings.button_label | escape }}
                    {%- if block.settings.button_icon -%}
                      <span class="button--icon button--icon-right">{% render 'icon-chevron-right' %}</span>
                    {%- endif -%}
                  </a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('click', function (event) {
    const trigger = event.target.closest('[data-hero-scroll-to-product-form="true"]');
    if (!trigger) return;

    const target = document.querySelector('.product_buy_button_form, product-form.product-form, form[id^="product-form-"]:not(#product-form-installment), .product-form__buttons');
    if (!target) return;

    event.preventDefault();
    target.scrollIntoView({
      behavior: 'smooth',
      block: 'center'
    });
  });
</script>

