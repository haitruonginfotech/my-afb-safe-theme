{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign poster = section.settings.cover_image | default: section.settings.video.preview_image
  assign video_alt = section.settings.video.alt | default: section.settings.video_description | default: section.settings.heading
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .product-catalogue-video__eyebrow,
  .section-{{ section.id }} .product-catalogue-video__accent,
  .section-{{ section.id }} .product-catalogue-video__meta {
    color: {{ section.settings.accent_color }};
  }

  .section-{{ section.id }} .product-catalogue-video__media {
    min-height: {{ section.settings.mobile_media_height }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }} .product-catalogue-video__media {
      min-height: {{ section.settings.media_height }}px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }} product-catalogue-video section-{{ section.id }}-padding">
  <div class="{{ section.settings.container }}{% unless section.settings.show_offset %} p-0{% endunless %}">
    <div class="product-catalogue-video__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-catalogue-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="product-catalogue-video__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="product-catalogue-video__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="product-catalogue-video__frame">
      <div class="product-catalogue-video__poster" aria-label="{{ video_alt | escape }}">
        <span class="product-catalogue-video__media">
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              class="product-catalogue-video__inline-video"
              src="https://www.youtube.com/embed/{{ video_id }}?playsinline=1&rel=0&controls=0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              title="{{ section.settings.video_description | escape }}"
            ></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe
              class="product-catalogue-video__inline-video"
              src="https://player.vimeo.com/video/{{ video_id }}?controls=0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              title="{{ section.settings.video_description | escape }}"
            ></iframe>
          {%- elsif section.settings.video != blank -%}
            {{
              section.settings.video
              | video_tag:
                image_size: '2400x',
                controls: false,
                playsinline: true,
                muted: false,
                loop: section.settings.enable_video_looping,
                class: 'product-catalogue-video__inline-video'
            }}
          {%- elsif poster != blank -%}
            {{
              poster
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 990, 1200, 1500, 1800, 2200, 2400',
                sizes: '(min-width: 1200px) 1200px, 100vw',
                class: 'product-catalogue-video__image',
                alt: poster.alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg product-catalogue-video__placeholder' }}
          {%- endif -%}
        </span>

        <span class="product-catalogue-video__shade" aria-hidden="true"></span>

        {%- if section.settings.video != blank or section.settings.video_url != blank -%}
          <button class="product-catalogue-video__play" type="button" aria-label="{{ 'sections.video.load_video' | t: description: video_alt | escape }}">
            <span class="product-catalogue-video__play-icon" aria-hidden="true"></span>
          </button>
        {%- endif -%}

        {%- if section.settings.logo != blank -%}
          <span class="product-catalogue-video__logo-wrap">
            {{
              section.settings.logo
              | image_url: width: 220
              | image_tag:
                loading: 'lazy',
                widths: '90, 140, 180, 220',
                class: 'product-catalogue-video__logo',
                alt: section.settings.logo.alt
            }}
          </span>
        {%- endif -%}

        <span class="product-catalogue-video__collection">
          {%- if section.settings.meta_label != blank -%}
            <span class="product-catalogue-video__meta">{{ section.settings.meta_label | escape }}</span>
          {%- endif -%}
          {%- if section.settings.catalogue_title != blank -%}
            <span class="product-catalogue-video__catalogue-title">{{ section.settings.catalogue_title | escape }}</span>
          {%- endif -%}
          {%- if section.settings.collection_title != blank -%}
            <span class="product-catalogue-video__accent">{{ section.settings.collection_title | escape }}</span>
          {%- endif -%}
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const playButton = section?.querySelector('.product-catalogue-video__play');

    if (!playButton) return;

    playButton.addEventListener('click', () => {
      const frame = playButton.closest('.product-catalogue-video__poster');
      const video = frame?.querySelector('video');
      const iframe = frame?.querySelector('iframe');

      frame?.classList.add('is-playing');

      if (video) {
        video.setAttribute('controls', 'controls');
        video.play();
        return;
      }

      if (iframe) {
        const url = new URL(iframe.src);
        url.searchParams.set('autoplay', '1');
        url.searchParams.set('controls', '1');
        iframe.src = url.toString();
      }
    });
  })();
</script>

<style>
  .product-catalogue-video {
    overflow: hidden;
  }

  .product-catalogue-video__intro {
    max-width: 720px;
    padding: 0 0 28px;
  }

  .product-catalogue-video__eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .product-catalogue-video__heading {
    margin: 0;
    color: currentColor;
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .product-catalogue-video__text {
    max-width: 580px;
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 13px;
    line-height: 1.65;
  }

  .product-catalogue-video__frame {
    position: relative;
    width: 100%;
  }

  .product-catalogue-video__poster {
    position: relative;
    display: block;
    width: 100%;
    min-height: inherit;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #262421;
    color: #fff;
    text-align: left;
    isolation: isolate;
  }

  .product-catalogue-video__media {
    display: block;
    position: relative;
    width: 100%;
    background: #302d29;
  }

  .product-catalogue-video__image,
  .product-catalogue-video__inline-video,
  .product-catalogue-video__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .product-catalogue-video__inline-video {
    border: 0;
    background: #000;
  }

  .product-catalogue-video__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.02) 48%, rgba(0, 0, 0, 0.58) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0) 52%);
    pointer-events: none;
  }

  .product-catalogue-video__logo-wrap {
    position: absolute;
    top: clamp(16px, 3vw, 36px);
    left: clamp(18px, 5vw, 64px);
    z-index: 2;
    max-width: 96px;
    pointer-events: none;
  }

  .product-catalogue-video__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-catalogue-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: flex;
    width: 58px;
    height: 58px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(31, 31, 31, 0.48);
    color: #fff;
    transform: translate(-50%, -50%);
    transition: background 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
  }

  .product-catalogue-video__play:hover,
  .product-catalogue-video__play:focus-visible {
    background: rgba(31, 31, 31, 0.68);
    transform: translate(-50%, -50%) scale(1.04);
  }

  .product-catalogue-video__poster.is-playing .product-catalogue-video__play {
    opacity: 0;
    pointer-events: none;
  }

  .product-catalogue-video__play-icon {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    border-left: 13px solid currentColor;
  }

  .product-catalogue-video__collection {
    position: absolute;
    left: clamp(20px, 5vw, 64px);
    bottom: clamp(24px, 5vw, 64px);
    z-index: 2;
    display: grid;
    gap: 2px;
    max-width: min(420px, calc(100% - 40px));
    pointer-events: none;
  }

  .product-catalogue-video__meta {
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .product-catalogue-video__catalogue-title,
  .product-catalogue-video__accent {
    font-family: var(--heading-global-family, var(--font-heading-family));
    font-size: clamp(28px, 3vw, 46px);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .product-catalogue-video__accent {
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .product-catalogue-video__intro {
      padding: 0 15px 24px;
    }

    .product-catalogue-video__text {
      font-size: 12px;
    }

    .product-catalogue-video__logo-wrap {
      max-width: 70px;
    }

    .product-catalogue-video__play {
      width: 48px;
      height: 48px;
    }

    .product-catalogue-video__collection {
      bottom: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "Product catalogue video",
  "tag": "section",
  "class": "spaced-section spaced-section--full-width",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_offset",
      "label": "Enable side offset",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Product catalogue"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Every Safe Come to Life"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore our full collection through our exclusive product catalogue video and discover the craftsmanship, luxury finishing, and innovative features behind every My AFB Safe product.</p>"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo overlay"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop Shopify-hosted video",
      "default": false
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "External video URL"
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Video description",
      "default": "Product catalogue video"
    },
    {
      "type": "text",
      "id": "meta_label",
      "label": "Bottom meta label",
      "default": "My AFB Safe - Official Video"
    },
    {
      "type": "text",
      "id": "catalogue_title",
      "label": "Catalogue title",
      "default": "Product Catalogue"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection title",
      "default": "2026 Collection"
    },
    {
      "type": "range",
      "id": "media_height",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Desktop poster height",
      "default": 620
    },
    {
      "type": "range",
      "id": "mobile_media_height",
      "min": 280,
      "max": 620,
      "step": 20,
      "unit": "px",
      "label": "Mobile poster height",
      "default": 440
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1a1a19"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b8a154"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 70
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 45
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 55
    }
  ],
  "presets": [
    {
      "name": "Product catalogue video",
      "category": "Video"
    }
  ]
}
{% endschema %}
