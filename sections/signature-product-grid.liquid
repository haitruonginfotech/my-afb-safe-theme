{%- liquid
  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  else
    assign container = 'container-fluid px-0'
  endif

  assign selected_collection = section.settings.collection
-%}

{%- style -%}
  .section-{{ section.id }} {
    background: {{ section.settings.body_background }};
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }} .signature-products__intro {
    padding-top: {{ section.settings.mobile_header_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_header_padding_bottom }}px;
    background: {{ section.settings.header_background }};
  }

  .section-{{ section.id }} .signature-products__eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }

  .section-{{ section.id }} .signature-products__heading {
    color: {{ section.settings.heading_color }};
  }

  .section-{{ section.id }} .signature-products__body {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .signature-products__grid {
    gap: {{ section.settings.mobile_grid_gap }}px;
  }

  .section-{{ section.id }} .signature-products__item {
    background: {{ section.settings.product_card_background }};
    padding: {{ section.settings.mobile_product_card_padding }}px;
  }

  .section-{{ section.id }} .signature-products__price {
    color: {{ section.settings.price_color }};
  }

  .section-{{ section.id }} .signature-products__badge {
    background: {{ section.settings.badge_background }};
    color: {{ section.settings.badge_text_color }};
  }

  .section-{{ section.id }} .signature-products__badge--accent {
    background: {{ section.settings.accent_badge_background }};
    color: {{ section.settings.accent_badge_text_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .signature-products__intro {
      padding-top: {{ section.settings.header_padding_top }}px;
      padding-bottom: {{ section.settings.header_padding_bottom }}px;
    }

    .section-{{ section.id }} .signature-products__body {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }} .signature-products__grid {
      column-gap: {{ section.settings.grid_column_gap }}px;
      row-gap: {{ section.settings.grid_row_gap }}px;
    }

    .section-{{ section.id }} .signature-products__item {
      padding: {{ section.settings.product_card_padding }}px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }} signature-products">
  <div class="signature-products__intro">
    <div class="{{ container }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="signature-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="signature-products__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  </div>

  <div class="signature-products__body">
    <div class="{{ container }}">
      <div class="signature-products__grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              assign product_image = block.settings.image
              if product_image == blank and product != blank
                assign product_image = product.featured_media.preview_image
              endif

              assign item_title = block.settings.title
              if item_title == blank and product != blank
                assign item_title = product.title
              endif

              assign item_description = block.settings.description
              if item_description == blank and product != blank
                assign item_description = product.description | strip_html | truncatewords: 18
              endif

              assign item_price = block.settings.price
              if item_price == blank and product != blank
                assign item_price = product.price | money
              endif

              if product != blank
                assign item_variant = product.selected_or_first_available_variant
              endif
            -%}
            <article class="signature-products__item" {{ block.shopify_attributes }}>
              <a
                class="signature-products__media"
                {% if product != blank %}
                  href="{{ product.url }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {%- if product_image != blank -%}
                  {%- liquid
                    assign image_height = product_image.width | divided_by: product_image.aspect_ratio
                  -%}
                  {{
                    product_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      width: product_image.width,
                      height: image_height,
                      widths: '360, 450, 540, 720, 900',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw',
                      class: 'signature-products__image',
                      alt: product_image.alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg signature-products__placeholder' }}
                {%- endif -%}

                {%- if block.settings.badge != blank -%}
                  <span class="signature-products__badge{% if block.settings.badge_style == 'accent' %} signature-products__badge--accent{% endif %}">
                    {{ block.settings.badge | escape }}
                  </span>
                {%- endif -%}
              </a>

              <div class="signature-products__content">
                {%- if item_title != blank -%}
                  <h3 class="signature-products__title">
                    {%- if product != blank -%}
                      <a href="{{ product.url }}">{{ item_title | escape }}</a>
                    {%- else -%}
                      {{ item_title | escape }}
                    {%- endif -%}
                  </h3>
                {%- endif -%}

                {%- if item_description != blank -%}
                  <p class="signature-products__description">{{ item_description | escape }}</p>
                {%- endif -%}

                <div class="signature-products__price-row">
                  {%- if item_price != blank -%}
                    <p class="signature-products__price">{{ item_price | escape }}</p>
                  {%- endif -%}

                  {%- if product != blank and item_variant != blank -%}
                    <product-form>
                      <form action="/cart/add" method="post" enctype="multipart/form-data" data-type="add-to-cart-form">
                        <input type="hidden" name="id" value="{{ item_variant.id }}">
                        <button
                          type="submit"
                          name="add"
                          class="signature-products__cart-button"
                          aria-label="{{ 'products.product.add_to_cart' | t }} - {{ product.title | escape }}"
                          {% unless item_variant.available %}
                            disabled
                          {% endunless %}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true" focusable="false">
                            <circle cx="21.9317" cy="21.9317" r="21.9317" fill="#CC1C21"/>
                            <path d="M15.6603 11.2792L12.5323 15.4498V30.0469C12.5323 30.6 12.752 31.1304 13.1431 31.5215C13.5342 31.9125 14.0646 32.1322 14.6177 32.1322H29.2148C29.7678 32.1322 30.2982 31.9125 30.6893 31.5215C31.0804 31.1304 31.3001 30.6 31.3001 30.0469V15.4498L28.1721 11.2792H15.6603Z" fill="#CC1C21" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M12.5323 15.4498H31.3001" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" fill="#CC1C21"/>
                            <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </form>
                    </product-form>
                  {%- else -%}
                    <button class="signature-products__cart-button" type="button" aria-label="Add to cart" disabled>
                      <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="21.9317" cy="21.9317" r="21.9317" fill="#CC1C21"/>
                        <path d="M15.6603 11.2792L12.5323 15.4498V30.0469C12.5323 30.6 12.752 31.1304 13.1431 31.5215C13.5342 31.9125 14.0646 32.1322 14.6177 32.1322H29.2148C29.7678 32.1322 30.2982 31.9125 30.6893 31.5215C31.0804 31.1304 31.3001 30.6 31.3001 30.0469V15.4498L28.1721 11.2792H15.6603Z" fill="#CC1C21" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M12.5323 15.4498H31.3001" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" fill="#CC1C21"/>
                        <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- elsif selected_collection != blank -%}
          {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
            <article class="signature-products__item">
              <a class="signature-products__media" href="{{ product.url }}">
                {%- if product.featured_media.preview_image != blank -%}
                  {%- liquid
                    assign product_image = product.featured_media.preview_image
                    assign image_height = product_image.width | divided_by: product_image.aspect_ratio
                  -%}
                  {{
                    product_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      width: product_image.width,
                      height: image_height,
                      widths: '360, 450, 540, 720, 900',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw',
                      class: 'signature-products__image',
                      alt: product_image.alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg signature-products__placeholder' }}
                {%- endif -%}
              </a>

              <div class="signature-products__content">
                <h3 class="signature-products__title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>
                <p class="signature-products__description">
                  {{ product.description | strip_html | truncatewords: 18 }}
                </p>
                <div class="signature-products__price-row">
                  <p class="signature-products__price">{{ product.price | money }}</p>
                  {%- assign item_variant = product.selected_or_first_available_variant -%}
                  <product-form>
                    <form action="/cart/add" method="post" enctype="multipart/form-data" data-type="add-to-cart-form">
                      <input type="hidden" name="id" value="{{ item_variant.id }}">
                      <button
                        type="submit"
                        name="add"
                        class="signature-products__cart-button"
                        aria-label="{{ 'products.product.add_to_cart' | t }} - {{ product.title | escape }}"
                        {% unless item_variant.available %}
                          disabled
                        {% endunless %}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true" focusable="false">
                          <circle cx="21.9317" cy="21.9317" r="21.9317" fill="#CC1C21"/>
                          <path d="M15.6603 11.2792L12.5323 15.4498V30.0469C12.5323 30.6 12.752 31.1304 13.1431 31.5215C13.5342 31.9125 14.0646 32.1322 14.6177 32.1322H29.2148C29.7678 32.1322 30.2982 31.9125 30.6893 31.5215C31.0804 31.1304 31.3001 30.6 31.3001 30.0469V15.4498L28.1721 11.2792H15.6603Z" fill="#CC1C21" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M12.5323 15.4498H31.3001" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" fill="#CC1C21"/>
                          <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    </form>
                  </product-form>
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for index in (1..4) -%}
            <article class="signature-products__item">
              <div class="signature-products__media">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg signature-products__placeholder' }}
              </div>
              <div class="signature-products__content">
                <h3 class="signature-products__title">Product title</h3>
                <p class="signature-products__description">Add a product or choose a collection to populate this signature grid.</p>
                <div class="signature-products__price-row">
                  <p class="signature-products__price">$399</p>
                  <button class="signature-products__cart-button" type="button" aria-label="Add to cart" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true" focusable="false">
                      <circle cx="21.9317" cy="21.9317" r="21.9317" fill="#CC1C21"/>
                      <path d="M15.6603 11.2792L12.5323 15.4498V30.0469C12.5323 30.6 12.752 31.1304 13.1431 31.5215C13.5342 31.9125 14.0646 32.1322 14.6177 32.1322H29.2148C29.7678 32.1322 30.2982 31.9125 30.6893 31.5215C31.0804 31.1304 31.3001 30.6 31.3001 30.0469V15.4498L28.1721 11.2792H15.6603Z" fill="#CC1C21" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12.5323 15.4498H31.3001" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" fill="#CC1C21"/>
                      <path d="M26.0867 19.6204C26.0867 20.7265 25.6473 21.7873 24.8652 22.5695C24.083 23.3516 23.0222 23.791 21.9161 23.791C20.81 23.791 19.7492 23.3516 18.967 22.5695C18.1849 21.7873 17.7455 20.7265 17.7455 19.6204" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .signature-products {
    overflow: hidden;
  }

  .signature-products__eyebrow {
    margin: 0 0 16px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 3.6px;
    text-transform: uppercase;
  }

  .signature-products__heading {
    margin: 0;
    font-family: var(--heading-global-family, var(--font-heading-family));
  }

  .signature-products__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .signature-products__item {
    min-width: 0;
  }

  .signature-products__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .signature-products__image,
  .signature-products__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .signature-products__media:hover .signature-products__image {
    transform: scale(1.025);
  }

  .signature-products__badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: inline-flex;
    min-height: 22px;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .signature-products__content {
    padding-top: 22px;
  }

  .signature-products__title {
    margin: 0;
    color: currentColor;
    font-family: var(--heading-global-family, var(--font-heading-family));
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .signature-products__title a {
    color: inherit;
    text-decoration: none;
  }

  .signature-products__title a:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .signature-products__description {
    max-width: 390px;
    min-height: 58px;
    margin: 10px 0 0;
    color: rgba(20, 20, 20, 0.62);
    font-size: 16px;
    line-height: 1.42;
  }

  .signature-products__price-row {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 34px;
  }

  .signature-products__price-row product-form,
  .signature-products__price-row form {
    flex: 0 0 auto;
    margin: 0;
  }

  .signature-products__price {
    margin: 0;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .signature-products__cart-button {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .signature-products__cart-button svg {
    display: block;
    width: 44px;
    height: 44px;
  }

  .signature-products__cart-button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .signature-products__cart-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media screen and (min-width: 640px) {
    .signature-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .signature-products__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .signature-products__eyebrow {
      margin-bottom: 12px;
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: 2.5px;
    }

    .signature-products__content {
      padding-top: 16px;
    }

    .signature-products__title {
      font-size: 21px;
    }

    .signature-products__description {
      min-height: 0;
      font-size: 15px;
    }

    .signature-products__price-row {
      margin-top: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Signature product grid",
  "class": "spaced-section spaced-section--full-width",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Signature Pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection",
      "info": "Used only when no product blocks are added."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show from collection",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "body_background",
      "label": "Product area background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#606060"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Product text",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_badge_background",
      "label": "Accent badge background",
      "default": "#b8943f"
    },
    {
      "type": "color",
      "id": "accent_badge_text_color",
      "label": "Accent badge text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "grid_column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Desktop column gap",
      "default": 48
    },
    {
      "type": "range",
