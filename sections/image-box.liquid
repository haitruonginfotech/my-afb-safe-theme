{% liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif
%}

<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'component-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-mobile-scrolling.css' | asset_url | stylesheet_tag }}
{{ 'section-title.css' | asset_url | stylesheet_tag }}
{{ 'section-image-box.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #MainContent > :first-child .section--top-space-{{ section.id }} {
    margin-top: calc(var(--header-height) * var(--transparent-header-show));
  }
{%- endstyle -%}

{% if theme_rtl %}
  {{ 'featured-promotion-rtl.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- liquid
  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  else
    assign container = 'container-fluid px-0'
  endif
-%}

<div class="image-box section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} section--top-space-{{ section.id }} gradient">
  <div class="{{ container }}">
    <div class="section-heading image-box__heading desktop-text-{{ section.settings.text_center }} mobile-text-{{ section.settings.mobile_text_center }} {% if section.settings.heading != blank or section.settings.description != blank %} mb-30{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if section.settings.heading_position == 'bottom' and section.settings.description != blank %}
        <div class="section-heading__sub_title {{ section.settings.description_style }} rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="section-heading__title {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.heading_position == 'top' and section.settings.description != blank %}
        <div class="section-heading__sub_title {{ section.settings.description_style }} rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.mobile_stack == false %}
      <div class="mobile--scoller">
        <div class="mobile--scoller-inner">
    {% endif %}

    <div
      class="image-box__grid {% if section.settings.show_separator %}image-box__separator{% endif %} grid grid--{{ section.settings.desktop_column }}-col-desktop grid--{{ section.settings.tablet_column }}-col-tablet-only grid--{{ section.settings.mobile_column }}-col-tablet-down"
      style="
        --image-box-image-width-desktop: {{ section.settings.image_width_desktop }}%;
        --image-box-image-width-mobile: {{ section.settings.image_width_mobile }}%;
        --image-box-side-image-width: {{ section.settings.side_image_width }}%;
        --image-box-separator-style: {{ section.settings.separator_style }};
        {% if section.settings.separator_color != blank %}
          --image-box-separator-color: rgba({{ section.settings.separator_color.red }}, {{ section.settings.separator_color.green }}, {{ section.settings.separator_color.blue }}, {{ section.settings.separator_alpha }});
        {% endif %}
      "
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_padding_desktop = section.settings.card_padding_desktop | default: 0
          assign card_padding_tablet = section.settings.card_padding_tablet | default: 0
          assign card_padding_mobile = section.settings.card_padding_mobile | default: 0
          assign card_heading_font_size_desktop = section.settings.card_heading_font_size_desktop | default: 18
          assign card_heading_font_size_tablet = section.settings.card_heading_font_size_tablet | default: 18
          assign card_heading_font_size_mobile = section.settings.card_heading_font_size_mobile | default: 18
          assign use_custom_card_padding = false
          if card_padding_desktop > 0 or card_padding_tablet > 0 or card_padding_mobile > 0
            assign use_custom_card_padding = true
          endif
        -%}
        <div
          class="grid__item image-box__card image-box__card--{{ section.settings.image_position }} text-{{ section.settings.alignment }} color-{{ section.settings.card_color_scheme }} {% unless section.settings.card_padding == 'none' or use_custom_card_padding %}image-box__card-padded-{{ section.settings.card_padding }} image-box__card-padded-mobile{% endunless %} {% if section.settings.card_radius %}image-box__card--rounded{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="
            --image-box-card-padding-desktop: {{ card_padding_desktop }}px;
            --image-box-card-padding-tablet: {{ card_padding_tablet }}px;
            --image-box-card-padding-mobile: {{ card_padding_mobile }}px;
            --image-box-card-border-width: {{ section.settings.card_border_width | default: 0 }}px;
            --image-box-card-border-color: {{ section.settings.card_border_color | default: 'transparent' }};
            --image-box-card-radius: {{ section.settings.card_border_radius }}px;
            --image-box-image-radius: {{ section.settings.image_border_radius }}px;
            --image-box-heading-size-desktop: {{ card_heading_font_size_desktop }}px;
            --image-box-heading-size-tablet: {{ card_heading_font_size_tablet }}px;
            --image-box-heading-size-mobile: {{ card_heading_font_size_mobile }}px;
            {% if section.settings.card_background_color != blank %}background-color: {{ section.settings.card_background_color }};{% endif %}
            {% if section.settings.card_box_shadow != blank %}box-shadow: {{ section.settings.card_box_shadow }};{% endif %}
            {% if settings.animations_reveal_on_scroll %}--animation-order: {{ forloop.index }};{% endif %}
          "
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          <div class="image-box__media-wrap">
            {%- if block.settings.image != blank -%}
              <div class="image-box__media image-box__media--rounded media media--{{ section.settings.image_ratio }}"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '165, 360, 533, 750, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    alt: block.settings.image.alt
                }}
              </div>
            {%- else -%}
              <div class="image-box__media image-box__media--rounded media media--{{ section.settings.image_ratio }} placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              </div>
            {%- endif -%}
          </div>

          <div class="image-box__content">
            {%- assign card_heading_tag = section.settings.card_heading_tag | default: 'h3' -%}
            {%- if block.settings.heading != blank -%}
              <{{ card_heading_tag }} class="image-box__title">
                {{ block.settings.heading }}
              </{{ card_heading_tag }}>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="image-box__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="image-box__link">
                <a
                  class="link with--icon"
                  {% if block.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                >
                  {{ block.settings.button_label | escape }}
                  {% if block.settings.button_icon %}
                    <span class="button--icon button--icon-right">{% render 'icon-chevron-right' %}</span>
                  {% endif %}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.mobile_stack == false %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image Box",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Boxed" },
        { "value": "container-fluid", "label": "Full width" }
      ]
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "hxl2", "label": "Heading XL2" },
        { "value": "hxl", "label": "Heading XL" },
        { "value": "h0", "label": "Heading 0 (Display)" },
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top",
      "label": "Heading position"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "Description style",
      "default": "body",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subtitle", "label": "Subtitle" }
      ]
    },
    {
      "type": "text_alignment",
      "id": "text_center",
      "label": "Desktop alignment",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_center",
      "label": "Mobile alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_column",
      "label": "Number of columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "tablet_column",
      "label": "Number of columns on tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_column",
      "label": "Number of columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "mobile_stack",
      "label": "Stack on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator on desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" },
        { "value": "double", "label": "Double" }
      ]
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color"
    },
    {
      "type": "range",
      "id": "separator_alpha",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Separator alpha",
      "default": 1
    },
    {
      "type": "header",
      "content": "Image box card"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "P" },
        { "value": "span", "label": "Span" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "card_heading_font_size_desktop",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading font size desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_heading_font_size_tablet",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading font size tablet",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_heading_font_size_mobile",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading font size mobile",
      "default": 18
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "right", "label": "Right" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image width desktop",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image width mobile",
      "default": 100
    },
    {
      "type": "range",
      "id": "side_image_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Side image width",
      "default": 35
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Desktop content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "card_padding",
      "label": "Desktop card padded",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "card_padding_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Custom padding desktop",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding_tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Custom padding tablet",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Custom padding mobile",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Card border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color"
    },
    {
      "type": "checkbox",
      "id": "card_radius",
      "label": "Round corner",
      "default": false
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 10
    },
    {
      "type": "text",
      "id": "card_box_shadow",
      "label": "Card box shadow",
      "info": "Example: 0 10px 30px rgba(0,0,0,0.12)"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "color_scheme",
