  "blocks": [
    {
      "type": "image_box",
      "name": "Image box card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Image box heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to highlight a feature, service, or benefit.</p>",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_icon",
          "label": "Show button icon",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Box",
      "blocks": [
        { "type": "image_box" },
        { "type": "image_box" },
        { "type": "image_box" }
      ]
    }
  ]
}
{% endschema %}
