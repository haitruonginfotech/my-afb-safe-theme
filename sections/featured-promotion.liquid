{% liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif
%}

<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'component-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-mobile-scrolling.css' | asset_url | stylesheet_tag }}
{{ 'section-title.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{{ 'featured-promotion.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #MainContent > :first-child .section--top-space-{{ section.id }} {
     margin-top: calc(var(--header-height) * var(--transparent-header-show));
   }
</style>

{% if theme_rtl %}
  {{ 'featured-promotion-rtl.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- liquid
  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  else
    assign container = 'container-fluid px-0'
  endif
-%}
<div class="text--with-icons section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} section--top-space-{{ section.id }} gradient">
  <div class="{{ container }}">
    <div
      class="section-heading text-with-icons__heading desktop-text-{{ section.settings.text_center }} mobile-text-{{ section.settings.mobile_text_center }} {% if section.settings.heading != blank or section.settings.description != blank %} mb-30{% endif %}  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      style="
        --text-with-icons-description-transform: {{ section.settings.description_text_transform | default: 'none' }};
        {% assign heading_font_size_value = section.settings.heading_font_size | strip | remove: 'px' %}
        {% assign description_font_size_value = section.settings.description_font_size | strip | remove: 'px' %}
      "
    >
      {% if section.settings.heading_position == 'bottom' and section.settings.description != blank %}
        <div
          class="section-heading__sub_title text-with-icons__description {{ section.settings.description_style }} rte"
          style="{% if description_font_size_value != blank %}font-size: {{ description_font_size_value }}px;{% endif %}{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}"
        >
          {{ section.settings.description -}}
        </div>
      {% endif %}
      <h2
        class="section-heading__title text-with-icons__title {{ section.settings.heading_size }}"
        style="{% if heading_font_size_value != blank %}font-size: {{ heading_font_size_value }}px;{% endif %}{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}"
      >
        {{- section.settings.heading -}}
      </h2>
      {% if section.settings.heading_position == 'top' and section.settings.description != blank %}
        <div
          class="section-heading__sub_title text-with-icons__description {{ section.settings.description_style }} rte"
          style="{% if description_font_size_value != blank %}font-size: {{ description_font_size_value }}px;{% endif %}{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}"
        >
          {{ section.settings.description -}}
        </div>
      {% endif %}
    </div>

    {% if section.settings.mobile_stack == false %}
      <div class="mobile--scoller">
        <div class="mobile--scoller-inner">
    {% endif %}

    <div
      class="promotion--grid {% if section.settings.show_separator %}promotion--card-spearator{% endif %} grid grid--{{ section.settings.desktop_column }}-col-desktop grid--{{ section.settings.tablet_column }}-col-tablet-only grid--{{ section.settings.mobile_column }}-col-tablet-down"
      style="
        --promotion-separator-style: {{ section.settings.separator_style }};
        {% if section.settings.separator_color != blank %}
          --promotion-separator-color: rgba({{ section.settings.separator_color.red }}, {{ section.settings.separator_color.green }}, {{ section.settings.separator_color.blue }}, {{ section.settings.separator_alpha }});
        {% else %}
          --promotion-separator-color: rgba(var(--color-foreground), 0.2);
        {% endif %}
      "
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'featured_promotion' -%}
            {%- liquid
              assign card_padding_desktop = section.settings.card_padding_desktop | default: 0
              assign card_padding_tablet = section.settings.card_padding_tablet | default: 0
              assign card_padding_mobile = section.settings.card_padding_mobile | default: 0
              assign card_heading_font_size_desktop = section.settings.card_heading_font_size_desktop | default: 18
              assign card_heading_font_size_tablet = section.settings.card_heading_font_size_tablet | default: 18
              assign card_heading_font_size_mobile = section.settings.card_heading_font_size_mobile | default: 18
              assign card_description_font_size_value = section.settings.card_description_font_size | strip | remove: 'px'
              assign use_custom_card_padding = false
              if card_padding_desktop > 0 or card_padding_tablet > 0 or card_padding_mobile > 0
                assign use_custom_card_padding = true
              endif

              assign block_icon_width_value = block.settings.icon_width | strip | remove: 'px'
              assign block_icon_render_width = block_icon_width_value
              if block_icon_render_width == blank
                assign block_icon_render_width = '70'
              endif

              assign block_max_width_value = block.settings.max_width | strip | remove: 'px'
            -%}
            <div
              class="grid__item promotion--card text-{{ section.settings.alignment }} promotion--card-icon--{{ section.settings.icon_position }} color-{{ section.settings.card_color_scheme }} {% unless section.settings.card_padding == "none" or use_custom_card_padding %}promotion--card-padded-{{ section.settings.card_padding }} promotion--card-padded-mobile{% endunless %} {% if section.settings.feature_card_radius %}card-border-radius-true{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              style="
                --promotion-card-padding-desktop: {{ card_padding_desktop }}px;
                --promotion-card-padding-tablet: {{ card_padding_tablet }}px;
                --promotion-card-padding-mobile: {{ card_padding_mobile }}px;
                --promotion-card-border-width: {{ section.settings.card_border_width | default: 0 }}px;
                --promotion-card-border-color: {{ section.settings.card_border_color | default: 'transparent' }};
                --promotion-card-heading-size-desktop: {{ card_heading_font_size_desktop }}px;
                --promotion-card-heading-size-tablet: {{ card_heading_font_size_tablet }}px;
                --promotion-card-heading-size-mobile: {{ card_heading_font_size_mobile }}px;
                {% if section.settings.card_heading_color != blank %}--promotion-card-heading-color: {{ section.settings.card_heading_color }};{% endif %}
                {% if card_description_font_size_value != blank %}--promotion-card-description-size: {{ card_description_font_size_value }}px;{% endif %}
                {% if section.settings.card_description_color != blank %}--promotion-card-description-color: {{ section.settings.card_description_color }};{% endif %}
                {% if block_icon_width_value != blank %}--icon-width: {{ block_icon_width_value }}px;{% endif %}
                {% if block_max_width_value != blank %}
                  --promotion-card-content-max-width: {{ block_max_width_value }}px;
                {% endif %}
                {% if section.settings.card_background_color != blank %}background-color: {{ section.settings.card_background_color }};{% endif %}
                {% if section.settings.card_box_shadow != blank %}box-shadow: {{ section.settings.card_box_shadow }};{% endif %}
                {% if settings.animations_reveal_on_scroll %}--animation-order: {{ forloop.index }};{% endif %}
              "
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
              {% endif %}
            >
              <div class="promotion--card-icon {% if block.settings.feature_image_icon != blank %}max-width-false{% endif %}">
                {%- if block.settings.feature_image_icon != blank -%}
                  <span class="featured-promotion--icon image--icon icon--position-{{ section.settings.alignment }}">
                    <img
                      src="{{ block.settings.feature_image_icon | image_url: width: 600 }}"
                      alt="{{ block.settings.feature_image_icon.alt | escape }}"
                      width="600"
                      height="{{ 600 | divided_by: block.settings.feature_image_icon.aspect_ratio | ceil }}"
                      loading="lazy"
                    >
                  </span>
                {% else %}
                  {%- render 'icon-featured-promotion',
                    icon: block.settings.icon,
                    icon_width: block_icon_render_width
                  -%}
                {%- endif -%}
              </div>
              <div class="promotion--card--content">
                {%- assign card_heading_tag = section.settings.card_heading_tag | default: 'h3' -%}
                <{{ card_heading_tag }} class="shipping__items--title">
                  {{ block.settings.heading }}
                </{{ card_heading_tag }}>
                <p class="shipping__items--desc">{{ block.settings.subheading }}</p>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {% if section.settings.mobile_stack == false %}
      </div>
      </div>
    {% endif %}
  </div>
</div>
