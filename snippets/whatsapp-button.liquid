{% liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif

  assign whatsapp_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
%}

<style>
  #whatsapp__button {
    position: fixed;
    bottom: calc(10rem + var(--mobile-navigation-bar-height));
    {% if theme_rtl %}
      left: 25px;
    {% else %}
      right: 25px;
    {% endif %}
    z-index: 98;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: #ffffff;
    background-color: #25d366;
    border-radius: 50%;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, background-color 0.2s ease;
    animation: whatsapp-ring 2.4s ease-out infinite;
  }

  #whatsapp__button:hover {
    color: #ffffff;
    background-color: #1ebe5d;
    transform: translateY(-2px);
  }

  #whatsapp__button svg {
    width: 26px;
    height: 26px;
    animation: whatsapp-shake 2.4s ease-in-out infinite;
    transform-origin: 50% 50%;
  }

  #whatsapp__button::before,
  #whatsapp__button::after {
    content: "";
    position: absolute;
    inset: -6px;
    border: 2px solid rgba(37, 211, 102, 0.45);
    border-radius: 50%;
    pointer-events: none;
    animation: whatsapp-pulse 2.4s ease-out infinite;
  }

  #whatsapp__button::after {
    animation-delay: 0.8s;
  }

  @keyframes whatsapp-ring {
    0%, 100% {
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18), 0 0 0 0 rgba(37, 211, 102, 0.35);
    }
    45% {
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18), 0 0 0 12px rgba(37, 211, 102, 0);
    }
  }

  @keyframes whatsapp-pulse {
    0% {
      opacity: 0.85;
      transform: scale(0.88);
    }
    70%, 100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes whatsapp-shake {
    0%, 72%, 100% {
      transform: rotate(0);
    }
    76% {
      transform: rotate(12deg);
    }
    80% {
      transform: rotate(-10deg);
    }
    84% {
      transform: rotate(8deg);
    }
    88% {
      transform: rotate(-6deg);
    }
    92% {
      transform: rotate(3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #whatsapp__button,
    #whatsapp__button svg,
    #whatsapp__button::before,
    #whatsapp__button::after {
      animation: none;
    }
  }
</style>

<a
  id="whatsapp__button"
  href="https://wa.me/{{ whatsapp_number }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
